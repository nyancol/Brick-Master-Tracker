# =============================================================================
# Brick Master Tracker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# docker-compose reads .env automatically.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# Optional.  When left blank docker-compose.yml assembles the URL from the
# individual *_USER / *_PASSWORD / *_DB vars below.
DATABASE_URL=

# Individual connection parts (used as fallback when DATABASE_URL is empty)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=brickmaster

# Host port for the database (mapped 5432:5432 inside the container network)
DB_PORT=5432

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------

# Port the Node.js API server listens on inside the container (always 5000)
# and the host port it is exposed as.
APP_PORT=5000

# Optional: override the working directory in the built image
# WORKDIR=/app
