# =============================================================================
# Brick Master Tracker — Environment Variables
# =============================================================================

# Port the Express server listens on.
PORT=5000

# Base directory for all persistent data (SQLite DB + uploaded images).
# Default: ./data
DATA_PATH=

# Absolute or relative path to the SQLite .db file.
# Default: $DATA_PATH/brick.db (if DATA_PATH is set)
# Override with a specific path if needed.
DB_PATH=

# Public-facing URL of the app (used for OIDC redirects behind reverse proxies).
# Example: https://bricks.example.com
# If not set, the OIDC_REDIRECT_URL and request host/protocol are used instead.
APP_URL=

# OIDC Authentication — required for login
# OIDC_ISSUER=https://pocket-id.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/api/auth/callback

# For RP-Initiated Logout, register the app root (e.g., http://localhost:5173/)
# as a post-logout redirect URI (post_logout_redirect_uri) in your OIDC
# provider's client settings. This is required for logout to redirect back.

# OIDC subject (sub claim) of the user who initially holds each brick.
# Leave empty to start with unheld bricks.
OIDC_OWNER_RED=
OIDC_OWNER_BLUE=

# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=