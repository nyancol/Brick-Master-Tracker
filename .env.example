# =============================================================================
# Brick Master Tracker — Environment Variables
# =============================================================================

# Port the Express server listens on.
PORT=5000

# Absolute or relative path to the SQLite .db file.
# Dev default: ./brick-tracker-data/brick.db
# Docker default: /app/data/brick.db (set in compose.yaml)
DB_PATH=

# Directory for uploaded images. Defaults to $DATA_PATH/uploads when unset;
# set this only to override (e.g. a separate disk).
# Dev default: ./brick-tracker-data/uploads
# Docker default: /app/data/uploads (set in compose.yaml)
IMAGE_PATH=

# Public-facing URL of the app (used for OIDC redirects behind reverse proxies).
# Example: https://bricks.example.com
# If not set, the OIDC_REDIRECT_URL and request host/protocol are used instead.
# When it starts with https://, session cookies are marked Secure.
APP_URL=

# OIDC Authentication — required for login
# OIDC_ISSUER=https://pocket-id.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/api/auth/callback

# OIDC subject (sub claim) of the user who initially holds each brick.
# Leave empty to start with unheld bricks.
OIDC_OWNER_RED=
OIDC_OWNER_BLUE=

# OIDC group names used to derive user roles. Members of the knights group are
# full participants (can hold bricks, appear on the leaderboard); everyone else
# is a visitor (can browse the site only). Must match the group names in the
# OIDC provider exactly, accents included. The app requests the "groups" scope;
# make sure it is enabled for the OIDC client in the provider.
OIDC_GROUP_KNIGHTS=Les Chevaliers de l'Amitié
OIDC_GROUP_VISITORS=Les Visiteurs

# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Development-only test-user login (no OIDC provider needed).
# Enabled by default in non-production; set to "false" to disable.
# Never active when NODE_ENV=production.
DEV_LOGIN=

# =============================================================================
# Observability (OpenTelemetry + Grafana LGTM)
# =============================================================================
# The observability stack lives in obs/ (standalone, one instance for the
# whole host) — start it first:  cd obs && docker compose up -d
# Telemetry is active only when OTEL_EXPORTER_OTLP_ENDPOINT is set (compose
# defaults it to http://lgtm:4318); leave it empty/commented to run without
# any telemetry export (plain stdout logging).
#
# Host-run dev instances send to the loopback-published collector instead:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
#
# Multiple instances (prod/preprod/dev) share one collector — distinguish them:
#   OTEL_SERVICE_NAME=brick-tracker            (default, stays stable)
#   OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
#   (preprod: ...name=preprod via compose.preprod.yaml; dev: ...name=development)
#
# Resource attributes set in code (server/telemetry.ts) — no operator action:
#   service.version comes from package.json automatically.
#   deployment.environment.name resolves as: explicit
#   deployment.environment.name inside OTEL_RESOURCE_ATTRIBUTES → APP_ENV
#   (dev, staging, production; default dev). The value `dev` is kept
#   intentionally instead of the spec enum `development` so existing Grafana
#   filters keep working. Set OTEL_RESOURCE_ATTRIBUTES only to override.
# Shutdown: SIGTERM/SIGINT closes the HTTP listener, flushes pending spans
# and metric batches (bounded ~5s so deploys never hang), then exits. Pino
# OTLP log batches flush best-effort.

# Overrides the compose default (http://lgtm:4318). Set to empty to disable
# telemetry entirely.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318

# service.name attached to all telemetry (default: brick-tracker)
#OTEL_SERVICE_NAME=brick-tracker

# Resource attributes for distinguishing environments in Grafana
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# Log level: fatal, error, warn, info, debug, trace (default: info)
#LOG_LEVEL=info

# Statements slower than this (ms) produce a "Slow SQL statement" warning
# (default: 100)
#SLOW_QUERY_THRESHOLD_MS=100

# Caddy (reverse proxy, outside this repo): route a hostname of your choice to
# `lgtm:3000` on the caddy_public network to reach the Grafana UI, e.g.
#   bricks-grafana.example.com {
#     reverse_proxy lgtm:3000
#   }
# The OTel collector ports (4317/4318) must stay internal — do not route them;
# 4318 is published on 127.0.0.1 only, for host-run dev instances.

# Feature flags — feature behavior lives in flags/flags.<env>.json (in git),
# rolled out by editing the file and git-pulling on the server. flagd watches
# the file; the server picks changes up without a restart.
# In containers FLAGD_HOST is set to the flagd sidecar (compose.yaml). Leave
# unset for host-run dev: the same flagd provider then runs in-process
# (embedded evaluator) watching flags/flags.dev.json — no flagd process needed.
#FLAGD_HOST=flagd

# Deployment environment identity: dev, staging, or production.
# Drives the UI environment badge (visible except in production).
# Unset defaults to dev. Compose pins this per environment — only set it
# here for unusual host-run setups.
#APP_ENV=dev
