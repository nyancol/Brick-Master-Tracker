# =============================================================================
# Brick Master Tracker — Environment Variables
# =============================================================================

# Port the Express server listens on.
PORT=5000

# Absolute or relative path to the SQLite .db file.
# Dev default: ./brick-tracker-data/brick.db
# Docker default: /app/data/brick.db (set in compose.yaml)
DB_PATH=

# Directory for uploaded images.
# Dev default: ./brick-tracker-data/uploads
# Docker default: /app/data/upload (set in compose.yaml)
IMAGE_PATH=

# Public-facing URL of the app (used for OIDC redirects behind reverse proxies).
# Example: https://bricks.example.com
# If not set, the OIDC_REDIRECT_URL and request host/protocol are used instead.
APP_URL=

# OIDC Authentication — required for login
# OIDC_ISSUER=https://pocket-id.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/api/auth/callback

# OIDC subject (sub claim) of the user who initially holds each brick.
# Leave empty to start with unheld bricks.
OIDC_OWNER_RED=
OIDC_OWNER_BLUE=

# OIDC group names used to derive user roles. Members of the knights group are
# full participants (can hold bricks, appear on the leaderboard); everyone else
# is a visitor (can browse the site only). Must match the group names in the
# OIDC provider exactly, accents included. The app requests the "groups" scope;
# make sure it is enabled for the OIDC client in the provider.
OIDC_GROUP_KNIGHTS=Les Chevaliers de l'Amitié
OIDC_GROUP_VISITORS=Les Visiteurs

# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Development-only test-user login (no OIDC provider needed).
# Enabled by default in non-production; set to "false" to disable.
# Never active when NODE_ENV=production.
DEV_LOGIN=
