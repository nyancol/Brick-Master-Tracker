# =============================================================================
# Brick Master Tracker — Environment Variables
# =============================================================================

# Port the Express server listens on.
PORT=5000

# Absolute or relative path to the SQLite .db file.
# Dev default: ./brick.db
# Prod default: /app/data/brick.db (set by Dockerfile)
DB_PATH=

# OIDC Authentication — required for login
# OIDC_ISSUER=https://pocket-id.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/api/auth/callback

# OIDC subject (sub claim) of the user who initially holds each brick.
# Leave empty to start with unheld bricks.
OIDC_OWNER_RED=
OIDC_OWNER_BLUE=

# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=