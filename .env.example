# =============================================================================
# Brick Master Tracker — Environment Variables
# =============================================================================
# Copy to .env if you want to override the defaults. Both have sensible
# defaults baked into the code/Dockerfile, so this file is optional.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Express server listens on inside the container / dev process.
# Default: 5000 in production, 5173 in dev (vite default).
PORT=

# ---------------------------------------------------------------------------
# SQLite database file
# ---------------------------------------------------------------------------

# Absolute or relative path to the SQLite .db file.
# Dev default:  ./brick.db (next to the working directory)
# Prod default: /app/deploy/data/brick.db (set by Dockerfile)
# Mount a volume at the parent directory to persist across container restarts.
DB_PATH=