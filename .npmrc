auto-install-peers=false
strict-peer-dependencies=false
# pnpm 11 auto-verifies deps before running scripts. The verification re-runs
# `pnpm install` internally, which fails on benign warnings about build scripts
# for transitive deps (esbuild ships prebuilt binaries and doesn't need its
# postinstall). Disable the auto-verify; CI/install itself still runs cleanly.
verify-deps-before-run=false